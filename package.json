{
  "name": "mi-app",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist/main/electron.cjs.js",
  "scripts": {
    "dev": "vite",
    "electron": "npm run electron:build && electron ./dist/main/electron.cjs.js",
    "electron:build": "tsc -b tsconfig.node.json",
    "electron:build-exe": "electron-builder",
    "build": "vite build",
    "start": "concurrently \"npm run dev\" \"npm run electron\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@types/express": "4.17.21",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "6.11.2",
    "lucide-react": "^0.511.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.1",
    "react-toastify": "^11.0.5",
    "reflect-metadata": "0.2.2",
    "sqlite3": "6.0.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "8.57.0",
    "@types/cors": "^2.8.18",
    "@types/electron": "1.6.12",
    "@types/node": "20.11.30",
    "@types/react": "18.2.41",
    "@types/react-dom": "18.2.17",
    "@vitejs/plugin-react": "4.4.0",
    "autoprefixer": "10.4.16",
    "concurrently": "8.2.2",
    "electron": "28.2.3",
    "electron-builder": "^26.15.3",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.3.4",
    "globals": "13.21.0",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.1",
    "ts-node": "10.9.1",
    "typescript": "5.2.2",
    "vite": "5.2.8",
    "wait-on": "7.0.1"
  },
  "build": {
    "appId": "com.tuempresa.tuapp",
    "productName": "NombreDeTuApp",
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "files": [
      "dist/",
      "dist/main/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
